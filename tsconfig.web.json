{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "strict": true, "jsx": "react-jsx",
    "skipLibCheck": true, "resolveJsonModule": true, "composite": true, "noUnusedLocals": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts"]
}
